# Copy this file to backend/.env and fill in the values:
#   cp .env.example backend/.env

# -- Database --
# Docker: compose starts the db container with POSTGRES_PASSWORD. The host port is 5434
# (not 5432), so a backend that runs outside Docker connects to 127.0.0.1:5434.
# On Windows with Docker Desktop prefer 127.0.0.1 over localhost (IPv6 resolution delay).
# Compose does not read backend/.env by itself. If you change the password, start the database with
# `docker compose --env-file backend/.env up -d db` and update DATABASE_URL to match.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/studyabroad

# -- OpenAI --
OPENAI_API_KEY=
# Optional: base URL of an OpenAI-compatible endpoint. Leave empty for the official API.
OPENAI_BASE_URL=
# Judgment and structured tasks (decomposer, verifier, critic, text-to-SQL) use OPENAI_MODEL;
# final answer generation uses OPENAI_ANSWER_MODEL. The paper used gpt-4o-mini and gpt-4o.
OPENAI_MODEL=gpt-4.1
OPENAI_ANSWER_MODEL=gpt-4o

# -- SerpAPI (faculty lookup) --
SERPAPI_KEY=your_serpapi_key_here

# -- Vector retrieval (optional) --
# Model paths for hybrid search; when empty the Hugging Face model id is downloaded.
# The models are only loaded once vectors exist: run `python -m data_crawler.backfill_embeddings` first.
# Until then, or if a model or sentence-transformers is missing, retrieval uses full-text search.
BGE_EMBED_MODEL_PATH=
BGE_RERANKER_MODEL_PATH=
# Set to false to skip loading the embedding and reranker models and use full-text search only.
ENABLE_HYBRID_SEARCH=true

# -- Crawler language model (optional) --
# data_crawler uses the first provider whose key is set; LLM_PROVIDER forces one of openai|groq|gemini.
# LLM_PROVIDER=
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# LLM_MAX_CONCURRENCY=2
# URL_FILTER_BATCH_SIZE=40
# ENABLE_EMBEDDING=false

# -- Language model client (optional) --
# LLM_REQUEST_TIMEOUT_SECONDS=45
# LLM_SDK_MAX_RETRIES=0

# -- Database client (optional) --
# Seconds to wait for a connection before giving up.
# DB_CONNECT_TIMEOUT=5

# -- API (optional) --
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
